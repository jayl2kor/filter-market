// Default signing configuration (committed)
// Override via Configs/Signing.local.xcconfig (gitignored, recommended)
//
// To enable archiving:
//   1. Copy Configs/Signing.local.xcconfig.example → Configs/Signing.local.xcconfig
//   2. Replace TEAMID with your Apple Developer Team ID
//   3. xcodegen generate
//   4. Archive in Xcode (Product → Archive)

#include? "Signing.local.xcconfig"

// Defaults if Signing.local.xcconfig is absent
DEVELOPMENT_TEAM = $(inherited)
CODE_SIGN_STYLE = Automatic
